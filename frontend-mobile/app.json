{
  "expo": {
    "name": "TeCommerce",
"slug": "frontend-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "tecommerce",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,

    "icon": "./assets/logo_tecommerce.png",

    "ios": {
      "supportsTablet": true,
      "icon": "./assets/logo_tecommerce.png"
    },

    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/logo_tecommerce.png",
        "backgroundColor": "#000000"
      },
      "splash": {
        "backgroundColor": "#000000",
        "image": "./assets/logo_tecommerce.png",
        "resizeMode": "contain"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.kevin_alexis.frontendmobile",
      "googleServicesFile": "./google-services.json"
    },

    "web": {
      "output": "static"
    },

    "plugins": [
      "expo-router",
      
      [
        "expo-splash-screen",
        {
          "image": "./assets/logo_tecommerce.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#000000",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ],
      "@react-native-community/datetimepicker",
      "expo-web-browser"
    ],

    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },

    "extra": {
      "router": {},
      "eas": {
        "projectId": "b38856b5-f299-44f3-bb84-2af4ab66e117"
      }
    }
  }
}